@model Staff
@{
    ViewData["Title"] = Model.FullName;
}

<div class="page-header">
    <a asp-action="Index" class="btn btn-back">← Orqaga</a>
    <h2>@Model.FullName</h2>
    <span class="status-badge @(Model.Status == StaffStatus.Active ? "status-active" : "status-blocked")">
        @Model.Status.GetDisplayName()
    </span>
</div>

<div class="detail-grid">
    <div class="detail-card">
        <div class="detail-avatar">
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <img src="@Model.PhotoPath" alt="@Model.FullName"
                     style="width: 160px; height: 160px; border-radius: 50%; object-fit: cover; border: 3px solid var(--border); margin-bottom: 12px;" />
            }
            else
            {
                <div class="avatar-lg">@Model.Initials</div>
            }
            <h3>@Model.FullName</h3>
            <span class="text-muted">@Model.Position</span>
        </div>
    </div>

    <div class="detail-card">
        <h4>Ish ma'lumotlari</h4>
        <div class="detail-row">
            <span class="detail-label">Lavozim:</span>
            <span>@Model.Position</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Bo'lim:</span>
            <span>@Model.Department.GetDisplayName()</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Smena:</span>
            <span>@Model.Shift.GetDisplayName()</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Kirish darajasi:</span>
            <span class="access-badge access-@Model.AccessLevel.ToString().ToLower()">@Model.AccessLevel.GetDisplayName()</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Holat:</span>
            <span>@Model.Status.GetDisplayName()</span>
        </div>
    </div>

    <div class="detail-card">
        <h4>Aloqa va tizim</h4>
        <div class="detail-row">
            <span class="detail-label">Telefon:</span>
            <span>@(Model.Phone ?? "—")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Yuz tanish:</span>
            <span class="toggle-indicator @(Model.FaceRecognitionEnabled ? "on" : "off")">
                @(Model.FaceRecognitionEnabled ? "Yoqilgan" : "O'chirilgan")
            </span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Qo'shilgan sana:</span>
            <span>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
        </div>
        <div class="detail-row">
            <span class="detail-label">Oxirgi kirish:</span>
            <span>@(Model.LastAccessTime?.ToString("dd.MM.yyyy HH:mm") ?? "—")</span>
        </div>
    </div>

    <div class="detail-card">
        <h4>Ruxsat etilgan turniketlar</h4>
        @if (Model.TurnstilePermissions.Any(tp => tp.IsAllowed))
        {
            @foreach (var tp in Model.TurnstilePermissions.Where(tp => tp.IsAllowed))
            {
                <div class="detail-row">
                    <span>🚪 @tp.Turnstile?.Name</span>
                    <span class="status-badge status-active">Ruxsat</span>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Turniket ruxsatlari tayinlanmagan</p>
        }
    </div>
</div>

<div class="form-actions">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">✏️ Tahrirlash</a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger" onclick="return confirm('@Model.FullName xodimini o\'chirishni tasdiqlaysizmi?')">🗑️ O'chirish</button>
    </form>
</div>
