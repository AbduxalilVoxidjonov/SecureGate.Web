@model CameraGroupFormViewModel
@{
    ViewData["Title"] = "Yangi kamera guruhi";
}

<div class="page-header">
    <a asp-action="Index" class="btn btn-back">← Orqaga</a>
    <h2>Yangi kamera guruhi</h2>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom:14px;"></div>

    @await Html.PartialAsync("_Form", Model)

    <div class="form-actions" style="margin-top:20px;">
        <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
        <button type="submit" class="btn btn-primary">Yaratish</button>
    </div>
</form>
