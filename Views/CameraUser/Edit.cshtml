@model CameraUserEditViewModel
@using SecureGate.Web.Models
@{
    ViewData["Title"] = $"Tahrirlash — {Model.FirstName} {Model.LastName}";
}

<div class="page-header">
    <a asp-action="Index" class="btn btn-back">← Orqaga</a>
    <h2>Yozuvni tahrirlash</h2>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ExistingPhotoPath" />

        <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom:14px;"></div>

        @if (!string.IsNullOrEmpty(Model.ExistingPhotoPath))
        {
            <div style="margin-bottom:16px;">
                <p style="font-size:12px; color:var(--text-muted); margin:0 0 6px;">Joriy rasm:</p>
                <img src="@Model.ExistingPhotoPath" alt="current"
                     style="max-width:180px; max-height:180px; border-radius:8px; border:2px solid var(--border);" />
            </div>
        }

        <div class="form-grid">
            <div class="form-group">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-input" />
                <span asp-validation-for="FirstName" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-input" />
                <span asp-validation-for="LastName" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="UserType" class="form-label"></label>
                <select asp-for="UserType" asp-items="Html.GetEnumSelectList<CameraUserType>()" class="form-select"></select>
            </div>

            <div class="form-group">
                <label asp-for="CameraId" class="form-label"></label>
                <select asp-for="CameraId" class="form-select">
                    <option value="">— Kamera tanlang —</option>
                    @foreach (var c in Model.AvailableCameras)
                    {
                        <option value="@c.Id" selected="@(Model.CameraId == c.Id)">@c.Name (@c.CameraCode)</option>
                    }
                </select>
                <span asp-validation-for="CameraId" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="DetectedAt" class="form-label"></label>
                <input asp-for="DetectedAt" type="datetime-local" class="form-input" />
            </div>

            <div class="form-group">
                <label asp-for="Confidence" class="form-label"></label>
                <input asp-for="Confidence" type="number" step="0.1" min="0" max="100" class="form-input" />
                <span asp-validation-for="Confidence" class="form-error"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Photo" class="form-label">Yangi rasm yuklash (ixtiyoriy)</label>
            <input asp-for="Photo" type="file" accept="image/*" class="form-input" style="padding:8px;" />
            <p style="font-size:11px; color:var(--text-dim); margin-top:6px;">
                Bo'sh qoldirsangiz, joriy rasm saqlanadi.
            </p>
        </div>

        <div class="form-group">
            <label asp-for="Note" class="form-label"></label>
            <textarea asp-for="Note" rows="3" class="form-input"></textarea>
        </div>

        <div class="form-switches">
            <label class="switch-label">
                <input asp-for="IsReviewed" type="checkbox" class="switch-input" />
                <span class="switch-slider"></span>
                <span>Ko'rib chiqilgan</span>
            </label>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
            <button type="submit" class="btn btn-primary">Saqlash</button>
        </div>
    </form>
</div>
