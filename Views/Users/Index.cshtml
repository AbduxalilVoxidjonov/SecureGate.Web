@model UsersListViewModel
@{
    ViewData["Title"] = "Foydalanuvchilar";
}

<div class="page-header">
    <div class="page-header-left">
        <h2>O'quvchilar ro'yxati</h2>
        <span class="badge">@Model.TotalCount ta</span>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Yangi o'quvchi</a>
</div>

<!-- Filtrlar -->
<div class="filter-bar">
    <form method="get" class="filter-form">
        <input type="text" name="search" value="@Model.SearchTerm" placeholder="Ism, familiya yoki ID..." class="form-input" />
        
        <select name="status" class="form-select">
            <option value="">Barcha holatlar</option>
            <option value="@StudentStatus.Active" selected="@(Model.StatusFilter == StudentStatus.Active)">Faol</option>
            <option value="@StudentStatus.Blocked" selected="@(Model.StatusFilter == StudentStatus.Blocked)">Bloklangan</option>
            <option value="@StudentStatus.New" selected="@(Model.StatusFilter == StudentStatus.New)">Yangi</option>
        </select>
        <button type="submit" class="btn btn-secondary">Qidirish</button>
    </form>
</div>

<!-- Jadval -->
<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>F.I.O</th>
                <th>Telefon</th>
                <th>Holat</th>
                <th>Yuz tanish</th>
                <th>Amallar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Students)
            {
                <tr>
                    <td><span class="student-id">#@s.StudentId</span></td>
                    <td>
                        <div class="user-cell">
                            <div class="user-avatar-sm">@s.Initials</div>
                            <div>
                                <div class="user-name-cell">@s.FullName</div>
                                <div class="user-sub">@(s.Gender == Gender.Male ? "Erkak" : "Ayol")</div>
                            </div>
                        </div>
                    </td>
                    
                    <td>@(s.Phone ?? "—")</td>
                    <td>
                        @if (s.Status == StudentStatus.Active)
                        {
                            <span class="status-badge status-active">Faol</span>
                        }
                        else if (s.Status == StudentStatus.Blocked)
                        {
                            <span class="status-badge status-blocked">Bloklangan</span>
                        }
                        else if (s.Status == StudentStatus.New)
                        {
                            <span class="status-badge status-new">Yangi</span>
                        }
                        else
                        {
                            <span class="status-badge status-archived">Arxivlangan</span>
                        }
                    </td>
                    <td>
                        <span class="toggle-indicator @(s.FaceRecognitionEnabled ? "on" : "off")">
                            @(s.FaceRecognitionEnabled ? "✓ Faol" : "✕ O'chiq")
                        </span>
                    </td>
                    <td>
                        <div class="action-btns">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn-icon" title="Tahrirlash">✏️</a>
                            <a asp-action="Details" asp-route-id="@s.Id" class="btn-icon" title="Batafsil">👁️</a>
                            @if (s.Status != StudentStatus.Blocked)
                            {
                                <form asp-action="Block" asp-route-id="@s.Id" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Reason" value="Admin tomonidan bloklangan" />
                                    <input type="hidden" name="ReasonType" value="@BlockReason.Other" />
                                    <button type="submit" class="btn-icon btn-danger-icon" title="Bloklash" onclick="return confirm('Rostdan ham bloklaysizmi?')">🔒</button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Unblock" asp-route-id="@s.Id" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn-icon btn-success-icon" title="Blokdan chiqarish">🔓</button>
                                </form>
                            }
                            <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-icon btn-danger-icon" title="O'chirish" onclick="return confirm('O\'chirishni tasdiqlaysizmi?')">🗑️</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Pagination -->
@if (Model.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchTerm" asp-route-groupId="@Model.GroupId" asp-route-status="@Model.StatusFilter"
               class="page-btn @(i == Model.CurrentPage ? "active" : "")">@i</a>
        }
    </div>
}
