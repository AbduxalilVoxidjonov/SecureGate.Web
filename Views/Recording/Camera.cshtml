@model RecordingArchiveViewModel
@{
    ViewData["Title"] = $"Arxiv — {Model.Camera.Name}";
    var existingCount = Model.Entries.Count(e => e.Exists);
}

<div class="page-header">
    <a asp-action="Index" class="btn btn-back">← Orqaga</a>
    <h2>@Model.Camera.Name <span style="color: var(--text-muted); font-weight: 400; font-size: 14px;">(@Model.Camera.CameraCode)</span></h2>
    <span class="badge">@existingCount / @Model.Entries.Count kun</span>
</div>

<div class="info-banner">
    <span>💾</span>
    <span>So'nggi 30 kunlik yozuvlar. Sana qatori yonidagi "Saqlab olish" tugmasini bossangiz, o'sha kungi video fayli yuklab olinadi.</span>
</div>

<div class="table-container">
    <table class="data-table">
        <thead>
            <tr>
                <th>Sana</th>
                <th>Hafta kuni</th>
                <th>Fayl nomi</th>
                <th>Hajm</th>
                <th>Holat</th>
                <th>Amal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td><strong>@entry.Date.ToString("dd.MM.yyyy")</strong></td>
                    <td>@entry.Date.ToString("dddd", new System.Globalization.CultureInfo("uz-UZ"))</td>
                    <td><code>@entry.FileName</code></td>
                    <td>@entry.SizeDisplay</td>
                    <td>
                        @if (entry.Exists)
                        {
                            <span class="status-badge status-active">Mavjud</span>
                        }
                        else
                        {
                            <span class="status-badge status-archived">Yozuv yo'q</span>
                        }
                    </td>
                    <td>
                        @if (entry.Exists)
                        {
                            <a asp-action="Download" asp-route-id="@Model.Camera.Id" asp-route-date="@entry.Date.ToString("yyyy-MM-dd")"
                               class="btn btn-sm btn-primary">⬇️ Saqlab olish</a>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-secondary" disabled>—</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
