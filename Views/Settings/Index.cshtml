@model List<Setting>
@{
    ViewData["Title"] = "Sozlamalar";
}

<div class="page-header"><h2>Tizim sozlamalari</h2></div>

<div class="settings-grid">
    @foreach (var s in Model)
    {
        <div class="setting-item">
            <div class="setting-info">
                <span class="setting-name">@(s.Description ?? s.Key)</span>
                <span class="setting-key text-muted">@s.Key</span>
            </div>
            @if (s.Type == SettingType.Boolean)
            {
                <label class="switch-label">
                    <input type="checkbox" class="switch-input" @(s.Value == "true" ? "checked" : "")
                           onchange="toggleSetting('@s.Key', this.checked)" />
                    <span class="switch-slider"></span>
                </label>
            }
            else
            {
                <div class="setting-value">
                    <span>@s.Value</span>
                    <form asp-action="Update" method="post" style="display:inline">
                        <input type="hidden" name="key" value="@s.Key" />
                        <input type="text" name="value" value="@s.Value" class="form-input form-input-sm" style="width:80px" />
                        <button type="submit" class="btn btn-sm btn-primary">Saqlash</button>
                    </form>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        async function toggleSetting(key, value) {
            const response = await fetch('/Settings/Toggle', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `key=${key}&value=${value}`
            });
            if (response.ok) showToast('Sozlama yangilandi', 'success');
        }
    </script>
}
