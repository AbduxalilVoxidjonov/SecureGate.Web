@model AdminCreateViewModel
@{
    ViewData["Title"] = "Yangi admin";
}

<div class="page-header">
    <a asp-action="Index" class="btn btn-back">← Orqaga</a>
    <h2>Yangi admin yaratish</h2>
</div>

<form asp-action="Create" method="post" id="adminCreateForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="form-error" style="margin-bottom: 14px;"></div>

    <!-- ===== XODIMNI TANLASH ===== -->
    <div class="card" style="padding: 20px; margin-bottom: 20px;">
        <h3 style="margin: 0 0 4px; font-size: 15px;">1. Xodimni tanlash</h3>
        <p style="margin: 0 0 14px; font-size: 12px; color: var(--text-muted);">
            Yangi admin akkaunt mavjud xodimga biriktiriladi. Ro'yxatdan kerakli xodimni qidiring va tanlang.
        </p>

        <input type="hidden" asp-for="StaffId" id="selectedStaffId" />
        <span asp-validation-for="StaffId" class="form-error" style="display:block; margin-bottom:8px;"></span>

        @if (!Model.AvailableStaff.Any())
        {
            <div class="info-banner">
                <span>ℹ️</span>
                <span>Bo'sh xodimlar yo'q — barchasi allaqachon admin akkauntga biriktirilgan yoki xodimlar ro'yxati bo'sh.</span>
            </div>
        }
        else
        {
            <input type="text" id="staffSearch" class="form-input" placeholder="Ism, lavozim yoki bo'lim bo'yicha qidirish..." style="margin-bottom: 14px;" />

            <div class="staff-picker" id="staffPicker">
                @foreach (var s in Model.AvailableStaff)
                {
                    <label class="staff-picker-item" data-search="@($"{s.FullName} {s.Position} {s.Department.GetDisplayName()}".ToLower())">
                        <input type="radio" name="StaffPick" value="@s.Id" />
                        <div class="staff-picker-avatar">
                            @if (!string.IsNullOrEmpty(s.PhotoPath))
                            {
                                <img src="@s.PhotoPath" alt="@s.FullName" />
                            }
                            else
                            {
                                <div class="avatar-initials">@s.Initials</div>
                            }
                        </div>
                        <div class="staff-picker-info">
                            <div class="staff-picker-name">@s.FullName</div>
                            <div class="staff-picker-meta">@s.Position · @s.Department.GetDisplayName()</div>
                        </div>
                        <span class="staff-picker-check">✓</span>
                    </label>
                }
            </div>
        }
    </div>

    <!-- ===== PAROL ===== -->
    <div class="card" style="padding: 20px; margin-bottom: 20px;">
        <h3 style="margin: 0 0 4px; font-size: 15px;">2. Kirish paroli</h3>
        <p style="margin: 0 0 14px; font-size: 12px; color: var(--text-muted);">
            Login (email) avtomatik yaratiladi: <code>staff-&lt;ID&gt;@@securegate.local</code>
        </p>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div class="form-group">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-input" type="password" />
                <span asp-validation-for="Password" class="form-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-input" type="password" />
                <span asp-validation-for="ConfirmPassword" class="form-error"></span>
            </div>
        </div>
    </div>

    <!-- ===== RUXSATLAR ===== -->
    <div class="card" style="padding: 20px; margin-bottom: 20px;">
        <h3 style="margin: 0 0 4px; font-size: 15px;">3. Ruxsatlar</h3>
        <p style="margin: 0 0 14px; font-size: 12px; color: var(--text-muted);">
            Bu admin qaysi bo'limlarga kira olishini va qanday amallarni bajara olishini belgilang.
        </p>
        @await Html.PartialAsync("_PermissionPicker", Model.SelectedPermissions)
    </div>

    <div style="display: flex; gap: 12px;">
        <button type="submit" class="btn btn-primary">Yaratish</button>
        <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
    </div>
</form>

@section Scripts {
<script>
(function () {
    const search = document.getElementById('staffSearch');
    const picker = document.getElementById('staffPicker');
    const hiddenId = document.getElementById('selectedStaffId');
    if (!picker) return;

    // Qidiruv: client-side filter
    if (search) {
        search.addEventListener('input', () => {
            const q = search.value.trim().toLowerCase();
            picker.querySelectorAll('.staff-picker-item').forEach(el => {
                const hay = el.dataset.search || '';
                el.style.display = (q === '' || hay.includes(q)) ? '' : 'none';
            });
        });
    }

    // Tanlash: radio o'zgarganda hidden StaffId'ni yangilaymiz va selected klassni qo'shamiz
    picker.querySelectorAll('input[type=radio][name=StaffPick]').forEach(radio => {
        radio.addEventListener('change', () => {
            picker.querySelectorAll('.staff-picker-item').forEach(el => el.classList.remove('selected'));
            radio.closest('.staff-picker-item').classList.add('selected');
            hiddenId.value = radio.value;
        });
    });
})();
</script>
<style>
    .staff-picker {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 8px;
        max-height: 420px;
        overflow-y: auto;
        padding: 4px;
    }
    .staff-picker-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        cursor: pointer;
        background: var(--bg-input);
        transition: background var(--transition), border-color var(--transition);
        position: relative;
    }
    .staff-picker-item:hover {
        background: var(--bg-card-hover);
        border-color: var(--border-light);
    }
    .staff-picker-item.selected {
        background: var(--primary-bg);
        border-color: var(--primary);
    }
    .staff-picker-item input[type=radio] {
        display: none;
    }
    .staff-picker-avatar {
        flex: 0 0 40px;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        overflow: hidden;
        background: var(--bg-card);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .staff-picker-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .staff-picker-avatar .avatar-initials {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-muted);
    }
    .staff-picker-info {
        flex: 1;
        min-width: 0;
    }
    .staff-picker-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .staff-picker-meta {
        font-size: 11px;
        color: var(--text-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .staff-picker-check {
        color: var(--primary);
        font-size: 18px;
        font-weight: 700;
        opacity: 0;
        transition: opacity var(--transition);
    }
    .staff-picker-item.selected .staff-picker-check {
        opacity: 1;
    }
</style>
}
