@model AdminResetPasswordViewModel
@{
    ViewData["Title"] = "Parolni o'zgartirish";
}

<div class="page-header">
    <h2>Parolni o'zgartirish</h2>
</div>

<form asp-action="ResetPassword" method="post" style="max-width:480px;">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card" style="padding:20px;">
        <p style="margin:0 0 16px; color:#475569;">
            <strong>@Model.FullName</strong> <br/>
            <span style="color:#64748b; font-size:13px;">@Model.Email</span>
        </p>

        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" type="password" class="form-input" />
            <span asp-validation-for="NewPassword" class="field-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" type="password" class="form-input" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

        <div style="margin-top:20px; display:flex; gap:12px;">
            <button type="submit" class="btn btn-primary">Saqlash</button>
            <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
        </div>
    </div>
</form>
