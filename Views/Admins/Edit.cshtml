@model AdminEditViewModel
@{
    ViewData["Title"] = "Adminni tahrirlash";
}

<div class="page-header">
    <h2>Adminni tahrirlash</h2>
</div>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsSuperAdmin" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="card" style="padding:20px; margin-bottom:20px;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" class="form-input" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-input" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
        </div>

        @if (!Model.IsSuperAdmin)
        {
            <div class="form-group" style="margin-top:12px;">
                <label style="display:flex; gap:8px; align-items:center;">
                    <input asp-for="IsActive" type="checkbox" />
                    <span>Faol akkaunt</span>
                </label>
            </div>
        }
    </div>

    @if (Model.IsSuperAdmin)
    {
        <div class="alert alert-info" style="padding:14px; background:#eff6ff; border:1px solid #bfdbfe; border-radius:8px; color:#1e40af;">
            <strong>SuperAdmin akkaunt:</strong> bu foydalanuvchi barcha ruxsatlarga ega va ular o'zgartirilmaydi.
        </div>
    }
    else
    {
        <h3 style="margin: 24px 0 12px;">Ruxsatlar</h3>
        @await Html.PartialAsync("_PermissionPicker", Model.SelectedPermissions)
    }

    <div style="margin-top:24px; display:flex; gap:12px;">
        <button type="submit" class="btn btn-primary">Saqlash</button>
        <a asp-action="Index" class="btn btn-secondary">Bekor qilish</a>
    </div>
</form>
